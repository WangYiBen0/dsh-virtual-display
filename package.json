{
  "name": "dsh-virtual-display",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Provision an isolated virtual display and capture real rendering without touching the user's session.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
